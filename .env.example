# School Dashboard - Environment Configuration
# Copy to .env and adjust values

# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://user:password@localhost:5432/school_dashboard?schema=public"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Auth / Security
JWT_SECRET="change-me-to-random-32-chars-minimum"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
SESSION_SECRET="change-me-session-secret"

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Dapodik Integration
DAPODIK_PROVIDER=mock
# DAPODIK_API_URL=https://dapodik.example
# DAPODIK_USERNAME=
# DAPODIK_PASSWORD=
DAPODIK_TIMEOUT_MS=30000

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
